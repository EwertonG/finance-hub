generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum RecurrenceKind {
  INSTALLMENT
  SUBSCRIPTION
}

enum DebtorStatus {
  PENDING
  CHARGED
  PAID
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String        @map("password_hash")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  categories   Category[]
  transactions Transaction[]
  debtors      Debtor[]
  recurrences  Recurrence[]

  @@map("users")
}

model Category {
  id           String        @id @default(uuid())
  name         String
  color        String        @default("#6B7280")
  type         TransactionType
  userId       String        @map("user_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  recurrences  Recurrence[]

  @@map("categories")
}

model Transaction {
  id                String          @id @default(uuid())
  description       String
  amount            Decimal         @db.Decimal(10, 2)
  date              DateTime
  type              TransactionType

  userId            String          @map("user_id")
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId        String?         @map("category_id")
  category          Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  recurrenceId      String?         @map("recurrence_id")
  recurrence        Recurrence?     @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  installmentNumber Int?            @map("installment_number")

  debtors     Debtor[]

  createdAt   DateTime        @default(now()) @map("created_at")

  @@map("transactions")
}

// Molde que gera transações: parcelamento (todas as N parcelas criadas de
// uma vez) ou assinatura (materializada sob demanda período a período).
model Recurrence {
  id               String          @id @default(uuid())
  description      String
  amount           Decimal         @db.Decimal(10, 2)
  type             TransactionType
  kind             RecurrenceKind
  startDate        DateTime        @map("start_date")
  installmentTotal Int?            @map("installment_total")
  active           Boolean         @default(true)

  userId           String          @map("user_id")
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId       String?         @map("category_id")
  category         Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  transactions     Transaction[]

  createdAt        DateTime        @default(now()) @map("created_at")

  @@map("recurrences")
}

model Debtor {
  id               String       @id @default(uuid())
  personName       String       @map("person_name")
  item             String       
  amount           Decimal      @db.Decimal(10, 2)
  totalAmount      Decimal?     @map("total_amount") @db.Decimal(10, 2) 
  status           DebtorStatus @default(PENDING)
  date             DateTime     @default(now())
  
  userId           String       @map("user_id")
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactionId    String?      @map("transaction_id")
  transaction      Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  createdAt        DateTime     @default(now()) @map("created_at")

  @@map("debtors")
}